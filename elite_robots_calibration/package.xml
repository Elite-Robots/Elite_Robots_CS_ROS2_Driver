<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>elite_robots_calibration</name>
  <version>1.0.1</version>
  <description>
    Package for extracting the factory calibration from a CS robot and change it such that it can be used by elite_robots_description to gain a correct URDF
  </description>
  
  <author>Chen Shichao</author>
  <maintainer email="chenshichao@elibot.cn">chenshichao</maintainer>
  <maintainer email="yanxiaojia@elibot.cn">Yan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>elite_cs_series_sdk</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
